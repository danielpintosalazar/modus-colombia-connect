# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Google Cloud / Firebase ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-key.json
FIREBASE_STORAGE_BUCKET=

# --- Vertex AI (Gemini) ---
VERTEX_AI_REGION=us-central1
VERTEX_AI_GEMINI_MODEL=gemini-2.5-flash

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=AIzaSyBDqvy6Wujh9xaxxkNEa7EYjyBqU6F1pk8

# --- Búsqueda de imágenes reales (fase de análisis) ---
# OPCIONAL: sin esto, /evidencias/buscar usa Wikimedia Commons y Openverse (sin clave).
# Para la fuente "google" (Programmable Search) hacen falta DOS cosas:
#  1) GOOGLE_CSE_ID — el "Search engine ID" de un motor creado en
#     https://programmablesearchengine.google.com (buscar en toda la web + imágenes ON).
#  2) Auth — UNA de estas dos:
#       GOOGLE_SEARCH_API_KEY       (API key con "Custom Search API" habilitada), o
#       GOOGLE_SEARCH_CREDENTIALS   (ruta a un JSON de cuenta de servicio con scope cse)
GOOGLE_CSE_ID=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CREDENTIALS=

# --- Sistema de Identificación de desastres (GET /desastres) ---
# Reusa GOOGLE_CSE_ID + GOOGLE_SEARCH_API_KEY (o GOOGLE_SEARCH_CREDENTIALS) de
# arriba, pero como búsqueda web de noticias. Caché: si ya hay un desastre
# buscado hace menos de estas horas, NO se vuelve a llamar a la API.
BUSQUEDA_DESASTRES_VENTANA_HORAS=12

# --- BigQuery (opcional, no bloqueante para la demo) ---
BIGQUERY_DATASET=metricas_desastre

# --- Resiliencia ---
# Si es "true", los agentes usan siempre el fallback simulado, ignorando Vertex AI
# (util para desarrollo local sin credenciales, o si Vertex AI falla en vivo).
AGENTS_FORCE_FALLBACK=false
EXTERNAL_CALL_TIMEOUT_SECONDS=12
