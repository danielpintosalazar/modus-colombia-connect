rules_version = '2';

// Firebase Storage: imágenes satelitales/de campo usadas por el Agente Diagnóstico.
// Solo entidad_respuesta y estado suben imágenes; lectura autenticada para cualquier rol
// (las necesitan para ver el resumen de diagnóstico de una zona).

service firebase.storage {
  match /b/{bucket}/o {
    match /zonas/{zonaId}/{imagenId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.rol in ['entidad_respuesta', 'estado']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
