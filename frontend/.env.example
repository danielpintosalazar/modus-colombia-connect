# URL del backend FastAPI. Si se deja vacía, el frontend usa datos mock locales.
VITE_API_URL=http://localhost:8000

# Fuerza datos mock aunque VITE_API_URL esté definida.
# Útil para ver el frontend mientras la conexión con el backend está en construcción.
VITE_USE_MOCK=false

# Google Maps API Key (generada en GCP Console > Credentials y restringida)
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase Auth (SDK web) ---
# Config pública del proyecto Firebase (Console > Project settings > General > Your apps).
# Si se dejan vacías, el login queda deshabilitado y la app usa el toggle de rol local
# + dev-token del backend. Basta con apiKey + authDomain + projectId para activarlo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

